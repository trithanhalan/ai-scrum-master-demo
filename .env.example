# Application Configuration
APP_ENV=development
DEBUG=true
FRONTEND_ORIGIN=http://localhost:3000

# Database & Cache
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/ai_scrum_master
REDIS_URL=redis://redis:6379/0

# JWT Configuration  
JWT_SECRET=change-me-in-production
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MIN=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.4

# Jira OAuth (PKCE) - Get these from Atlassian Developer Console
OAUTH_CLIENT_ID=your-jira-oauth-client-id
OAUTH_CLIENT_SECRET=your-jira-oauth-client-secret
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
OAUTH_SCOPES=read:jira-user read:jira-work write:jira-work offline_access
OAUTH_AUTHORIZE_URL=https://auth.atlassian.com/authorize
OAUTH_TOKEN_URL=https://auth.atlassian.com/oauth/token
OAUTH_AUDIENCE=api.atlassian.com

# Webhook Configuration
WEBHOOK_SHARED_SECRET=your-webhook-secret-here

# Slack/GitHub placeholders (for future integrations)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws