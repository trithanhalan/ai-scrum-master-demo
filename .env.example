# Application Configuration
APP_ENV=development
DEBUG=true

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# Database & Cache
DATABASE_URL=sqlite:////data/app.db
REDIS_URL=redis://redis:6379/0

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-change-me
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MIN=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI Configuration (optional for demo mode)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.4

# Jira OAuth Configuration (REQUIRED)
OAUTH_CLIENT_ID=REPLACE_ME_WITH_YOUR_ATLASSIAN_CLIENT_ID
OAUTH_CLIENT_SECRET=REPLACE_ME_WITH_YOUR_ATLASSIAN_CLIENT_SECRET
REDIRECT_URI=http://localhost:8001/auth/callback

# Jira API Configuration (optional fallback)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=REPLACE_ME_WITH_YOUR_JIRA_API_TOKEN

# Webhook Configuration (optional)
WEBHOOK_SHARED_SECRET=your-webhook-secret

# Future integrations (placeholders)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=